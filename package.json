{
  "name": "tracebit",
  "productName": "TraceBit",
  "version": "0.2.0",
  "description": "本地行为记录 + AI 日分析：记录窗口焦点与屏幕快照，生成每日行为报告与省力优化建议",
  "author": "TraceBit",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "ws": "^8.22.2"
  },
  "build": {
    "appId": "app.tracebit.desktop",
    "productName": "TraceBit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/ps/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
